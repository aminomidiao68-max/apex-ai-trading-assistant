# Development defaults for the APEX AI backend. Real external credentials are
# delivered via /run/base44/app.env (platform secrets) and override these.
APP_NAME=APEX AI Trading API
APP_VERSION=3.31.0-pro-alpha78
DEFAULT_TIMEZONE=UTC

# SQLite fallback when no DATABASE_URL is set (local dev).
DATABASE_URL=
DATABASE_PATH=
DATABASE_POOL_MAX_SIZE=8
DATABASE_CONNECT_TIMEOUT_SECONDS=8

# Seed the demo user (demo@apexai.app / Demo12345!) in development.
SEED_DEMO_USER=true
SESSION_TTL_HOURS=168

USER_SECRET_KEY_VERSION=1

# Rate limiting (dev-friendly).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_HEAVY_PER_MINUTE=15
TRUST_PROXY_HEADERS=true
MAX_REQUEST_BODY_BYTES=2097152

# Deterministic AI by default; external AI keys are optional (set via secrets).
AI_PROVIDER=deterministic
AI_EXTERNAL_ENABLED=false

# Paper trading feed worker (synthetic data, no external key needed).
PAPER_FEED_WORKER_ENABLED=true
PAPER_FEED_WORKER_SWEEP_SECONDS=2
PAPER_FEED_WORKER_BATCH_SIZE=20
PAPER_FEED_WORKER_PROVIDER_TIMEOUT_SECONDS=8
PAPER_CHAOS_ENABLED=false

# Safety switches (must stay off).
ENABLE_TESTNET_EXECUTION=false
ENABLE_LIVE_EXECUTION=false
SIGNAL_SHADOW_WORKER_ENABLED=false
